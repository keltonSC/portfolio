{
  "name": "Painel fictício — Python 3.13",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "customizations": {"vscode": {"extensions": ["ms-python.python", "ms-python.vscode-pylance"]}},
  "postCreateCommand": "python -m venv .venv && .venv/bin/python -m pip install -r requirements.lock",
  "postAttachCommand": {"server": ".venv/bin/python -m streamlit run projeto1.py --server.enableCORS true --server.enableXsrfProtection true"},
  "portsAttributes": {"8501": {"label": "Demonstração", "onAutoForward": "notify"}},
  "forwardPorts": [8501]
}
